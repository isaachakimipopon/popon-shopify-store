{% doc %}
  Renders a native product form for the current product.
  @param {product} product - Current product
  @param {string} section_id - Unique section ID
  @param {string} label - Editable button label
{% enddoc %}
{% liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'propod-buy-' | append: section_id
%}
<div class="pp-price">{{ variant.price | money }}{% if variant.compare_at_price > variant.price %}<s>{{ variant.compare_at_price | money }}</s>{% endif %}</div>
{% form 'product', product, id: form_id, class: 'pp-form' %}
  {{ form.errors | default_errors }}
  {% if product.has_only_default_variant %}
    <input type="hidden" name="id" value="{{ variant.id }}">
  {% else %}
    <select name="id" aria-label="{{ product.title | escape }}">
      {% for option in product.variants %}<option value="{{ option.id }}" {% if option.id == variant.id %}selected{% endif %} {% unless option.available %}disabled{% endunless %}>{{ option.title | escape }} — {{ option.price | money }}</option>{% endfor %}
    </select>
  {% endif %}
  <input type="hidden" name="quantity" value="1">
  <button class="pp-button" type="submit" name="add" {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ label | escape }}{% else %}{{ 'blocks.sold_out' | t }}{% endif %}</button>
{% endform %}
